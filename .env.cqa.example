# Copy to .env.cqa (ignored by Git).
# python scripts/run-cqa.py --configure-source saves the organizer URL privately.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct
# two_pass = evaluator + critic; multi_agent = criterion specialists + critic.
CQA_STRATEGY=two_pass
CQA_AGENT_CONCURRENCY=1
LLM_CONCURRENCY=1
LLM_TIMEOUT=600
CQA_JOB_TIMEOUT=1800
LLM_CONTEXT_SIZE=65536
LLM_OUTPUT_LIMIT=4096
DATABASE_URL=sqlite:///.runtime/cqa-foundation.db
