# Copy to .env.cqa. The private file is ignored by Git.
# Use: python scripts/run-cqa.py --configure-source
# The signed organizer URL is entered privately; never commit it here.
CQA_STRATEGY=multi_agent
CQA_AGENT_CONCURRENCY=1
CQA_CONCURRENCY=1
CQA_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
CQA_DB=.runtime/cqa.sqlite3
