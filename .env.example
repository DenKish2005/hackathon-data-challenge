REDIS_URL=redis://localhost:6379/0
# Only the optional real API example needs this:
OPENAI_API_KEY=
# Set a random secret (>=32 bytes) in your own transport service, never in clients.
RUN_CONTEXT_SECRET=

# CQA Backend Foundation. Export these as environment variables before starting the service.
# Never put actual signed URLs or keys in source control.
FREEDOM_DEV_API_URL=
FREEDOM_CONTROL_API_URL=
DATABASE_URL=sqlite:///.runtime/cqa-foundation.db
CQA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CQA_WORKERS=2
CQA_JOB_TIMEOUT=120
CQA_ENABLE_CRITIC=true
LLM_TIMEOUT=60
LLM_CONCURRENCY=1
LLM_ATTEMPTS=3
LLM_CONTEXT_SIZE=65536
LLM_OUTPUT_LIMIT=8000
CQA_FRONTEND_DIR=frontend/dist
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Set true only after organizer permission to send conversation data externally.
CQA_ALLOW_EXTERNAL_DATA=false
